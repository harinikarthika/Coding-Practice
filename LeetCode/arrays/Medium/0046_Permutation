class Solution:
    def permute(self, nums: List[int]) -> List[List[int]]:
        if not nums:
            return [[]]
        
        result = []
        for i in range(len(nums)):
            pivot = nums[i]
            
            remaining = nums[:i] + nums[i+1:]
            
            for p in self.permute(remaining):
                result.append([pivot] + p)
                
        return result
