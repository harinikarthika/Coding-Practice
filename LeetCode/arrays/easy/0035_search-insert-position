int searchInsert(int* nums, int numsSize, int target) {
    for (int i = 0; i < numsSize; i++) {
    if (nums[i] == target) {
        return i;
    }
    if (target <= nums[0])
    {
      return 0; 
    }
    else if (target > nums[i] && (i + 1 < numsSize) && target < nums[i + 1]) {
        return i + 1;
    }
    }
    return numsSize;
}
